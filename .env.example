# Copie para .env e ajuste. Nenhum valor abaixo e um segredo real.
NODE_ENV=development
PORT=3000

# Arquivo SQLite local (criado automaticamente pelas migracoes).
DATABASE_FILE=./data/rede-restaurantes.db

# Obrigatorio. Gere um valor aleatorio com pelo menos 32 caracteres, por exemplo:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRACAO=1h

# Custo do bcrypt (10 a 14).
BCRYPT_CUSTO=11

# Limite de tentativas de login por IP + e-mail dentro da janela.
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_MS=900000

# Origens liberadas para CORS, separadas por virgula. Vazio = CORS desligado.
CORS_ORIGENS=http://localhost:3000

# Pedido nao pago expira apos este tempo (premissa do projeto).
PEDIDO_EXPIRACAO_MINUTOS=15

# Tempo maximo de espera pela resposta do gateway de pagamento.
PAGAMENTO_TIMEOUT_MS=3000

# Gateway simulado (somente desenvolvimento e teste).
MOCK_PAGAMENTO_LATENCIA_MS=50
MOCK_PAGAMENTO_CENARIO_PADRAO=APROVAR
MOCK_PAGAMENTO_PERMITIR_CENARIO=true
MOCK_PAGAMENTO_RESULTADO_CONSULTA=APROVADO
