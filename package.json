{
  "name": "rede-restaurantes-api",
  "version": "1.0.0",
  "description": "API back-end para uma rede de restaurantes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "db:migrate": "node scripts/migrar.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/resetar-banco.js",
    "test": "node --test --test-concurrency=4 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "marked": "18.1.2",
    "newman": "6.2.3"
  }
}
